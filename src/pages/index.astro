---
import Hero from "../components/landing/Hero.astro";
import Hook from "../components/landing/Hook.astro";
import Offer from "../components/landing/Offer.astro";
import Testimonial from "../components/landing/Testimonial.astro";
import Warranty from "../components/landing/Warranty.astro";
import MainLayout from "../layouts/MainLayout.astro";
import { PAGES_METADATA, getOrganizationSchema } from "../lib/seo";

const meta = PAGES_METADATA.home;
const schema = getOrganizationSchema();
---

<MainLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  keywords={meta.keywords}
  schema={schema}
>
  <Hero />
  <Hook />
  <Offer />
  <Warranty />
  <Testimonial />
</MainLayout>
