---
import Hero from "../components/landing/Hero.astro";
import Hook from "../components/landing/Hook.astro";
import Offer from "../components/landing/Offer.astro";
import MainLayout from "../layouts/MainLayout.astro";

const metaData = {
    title: 'Diseño Web y Posicionamiento Local en Coahuila | DevWorks Studio',
    description: 'Convierte tu sitio web en un sistema de ventas 24/7. Diseño web de alta velocidad, SEO local en Google y soporte continuo para empresas en Coahuila.'
