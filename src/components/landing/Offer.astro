---
import { Image } from "astro:assets";
import offerImg from '../../assets/images/ds-img1.jpg'
import { ArrowUpRight } from "@lucide/astro";
import Button from "../ui/Button.astro";
import { Icon } from 'astro-icon/components'
import transport from '../../assets/images/transport.jpg'
import healthcare from '../../assets/images/healthcare.jpg'
---

<section id="services" class="bg-primary-dark transition-colors ease-linear duration-200">
    <div class="px-4 md:px-11 lg:px-20 py-28 max-w-8xl mx-auto text-secondary-light">
        <div class="flex flex-col lg:flex-row gap-20 items-center lg:items-start">
            <div class="flex-1">
                <Image src={offerImg} alt='Servicios DevWorks Studio | Imagen' class='w-full aspect-square rounded-2xl object-cover' />
            </div>
            <div class="flex-1 py-8 h-full">
                <h2 class="text-4xl font-unb font-semibold text-font-light mb-auto">No hacemos sitios web informales. <span class="text-[#AED7EA]">Instalamos un vendedor institucional que trabaja 24/7.</span></h2>
                <p class="text-lg mt-6">
                    Nos encargamos de toda la ingeniería comercial y técnica para que tu única tarea sea atender a los clientes que llegan listos para comprar.
                </p>
                <span class="w-full h-px bg-primary-light block my-12"></span>
                <div class="grid grid-cols-1 gap-8 mb-12">
                    <div class="">
                        <Icon name="ic:baseline-mobile-friendly" size="1.6rem" class="mb-4"/>
                        <h5 class="flex-1 font-unb font-semibold mb-1">Sitio Web Mobile-First</h5>
                        <p class="flex-1 text-base text-secondary-light">Carga en menos de 1 segundo en celulares, filtra las dudas frecuentes y guía al prospecto a agendar directamente.</p>
                    </div>
                    <div class="">
                        <Icon name="ic:round-business" size="1.6rem" class="mb-4"/>
                        <h5 class="flex-1 font-unb font-semibold mb-1">Google Workspace Blindado</h5>
                        <p class="flex-1 text-base text-secondary-light">Elimina el correo de Gmail. Tus cotizaciones se envían desde direccion@tuempresa.com con certificados de seguridad que evitan la bandeja de spam.</p>
                    </div>
                    <div class="">
                        <Icon name="ic:outline-map" size="1.6rem" class="mb-4"/>
                        <h5 class="flex-1 font-unb font-semibold mb-1">Configuración de Google Maps (GBP)</h5>
                        <p class="flex-1 text-base text-secondary-light">Garantiza que quienes buscan tus servicios en Piedras Negras o la región te encuentren con credenciales y opiniones de 5 estrellas.</p>
                    </div>
                    <div class="">
                        <Icon name="ic:outline-home-repair-service" size="1.6rem" class="mb-4"/>
                        <h5 class="flex-1 font-unb font-semibold mb-1">Gestión y Mantenimiento Total</h5>
                        <p class="flex-1 text-base text-secondary-light">Si requieres cambiar fotos, unidades o servicios, nos mandas un WhatsApp y lo actualizamos por ti en menos de 24 horas. Cero dolores de cabeza técnicos.</p>
                    </div>
                </div>
                <Button variant="secondary" label="Agenda tu consulta inicial" target="_blank" href="https://cal.com/devworksstudio/consultoria-gratuita">
                    <ArrowUpRight slot={'right-icon'}/>
                </Button>
            </div>
        </div>
        <span class="w-full h-px bg-primary-light block my-12"></span>
        <div class="px-3">
            <h3 class="font-unb font-semibold text-xl">Selecciona tu industria para ver la solución exacta para tu negocio:</h3>
            <div class="mt-12 flex flex-col lg:flex-row gap-20">
                <div class="flex-1">
                    <Image src={healthcare} alt={'Soluciones para consultorios medicos y dentistas'} class="object-cover w-full h-80 rounded-xl mb-6"/>
                    <h5 class="font-bold text-lg">Clínicas, Médicos y Turismo Dental:</h5>
                    <p class="text-base mb-8">Para especialistas que desean atraer pacientes de alto valor de Coahuila y el sur de Texas, eliminando a los curiosos de redes.</p>
                    <Button variant="secondary" label="Ver sistema para salud" target="_blank" href="https://cal.com/devworksstudio/consultoria-gratuita">
                        <ArrowUpRight slot={'right-icon'}/>
                    </Button>
                </div>
                <div class="flex-1">
                    <Image src={transport} alt={'Soluciones para empresas de transporte'} class="object-cover w-full h-80 rounded-xl mb-6"/>
                    <h5 class="font-bold text-lg">Transporte de Carga y Transfers:</h5>
                    <p class="text-base mb-8">Para líneas de autotransporte que necesitan validar su flota ante maquilas/brokers y reclutar choferes de quinta rueda.</p>
                    <Button variant="secondary" label="Ver sistema para transporte" target="_blank" href="https://cal.com/devworksstudio/consultoria-gratuita">
                        <ArrowUpRight slot={'right-icon'}/>
                    </Button>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
const container = document.querySelector('#services')
const section = document.querySelector("#service-section") as HTMLDivElement;

const options = {
  root: null,
  rootMargin: "0px",
  threshold: 0.1
};

const colorChange = (entries: IntersectionObserverEntry[]) => {
    if (entries[0].isIntersecting) {
        container?.classList.add('bg-color-white')
        container?.classList.remove('bg-primary-dark')
    } else {
        container?.classList.remove('bg-color-white!');
        container?.classList.add('bg-primary-dark')
    }
};

const observer = new IntersectionObserver(colorChange, options);
observer.observe(section);
</script>
