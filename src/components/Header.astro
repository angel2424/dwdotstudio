---
import { Image } from "astro:assets"
import coloredLogo from '../assets/images/ds-color-logo.svg'
import whiteLogo from '../assets/images/ds-white-logo.svg'
import Button from "./ui/Button.astro"
import { ArrowUpRight } from '@lucide/astro'

const menuItems = [
    {
        label: 'Servicios',
        path: '/servicios'
    },
    {
        label: 'Proyectos',
        path: '/proyectos'
    },
    {
        label: 'Planes y Precios',
        path: '/proyectos'
    },
]
---
<header class='fixed md:relative flex items-center px-6 md:px-11 xl:px-20 py-6 z-50 w-full'>
    <a href="/" class="mr-auto">
        <Image src={coloredLogo} class='hidden md:block' alt="DevWorks Studio Logo | Agencia Web que crea productos que venden." height={40} width={150} fit="contain" />
        <Image src={whiteLogo} class='block md:hidden' alt="DevWorks Studio Logo | Agencia Web que crea productos que venden." height={40} width={120} fit="contain" />
    </a>
    <div class="items-center gap-12 hidden lg:flex">
        <nav class="flex items-center gap-2 font-unb text-sm">
            {
                menuItems.map(item => (
                    <a href={item.path} class="clip flex flex-col items-center gap-1 hover:text-primary relative after:absolute after:bottom-0 after:opacity-0 after:w-1.5 after:h-1.5 after:rounded-full after:bg-primary hover:after:opacity-100 after:transition after:ease-in-out after:duration-200 px-4 py-2">{item.label}</a>
                ))
            }
        </nav>
        <Button label="Agendar Diagnóstico Gratuito" href="https://cal.com/devworksstudio/consultoria-gratuita">
            <ArrowUpRight slot="right-icon"/>
        </Button>
    </div>
    <button id="burger" data-open="open" class="relative z-110 flex lg:hidden flex-col gap-1 bg-transparent border-0 cursor-pointer py-2 transition ease-in-out duration-200">
        <span class="w-8 h-[3px] rounded-full bg-secondary-light md:bg-primary-dark transition ease-linear duration-200"></span>
        <span class="w-8 h-[3px] rounded-full bg-secondary-light md:bg-primary-dark transition ease-linear duration-200"></span>
    </button>
    <div id="mobile-menu" class="gap-12 lg:hidden flex flex-col justify-center items-center fixed top-0 left-0 h-full w-full z-99 bg-secondary-dark translate-x-full transition duration-200 ease-linear">
        <nav class="flex flex-col gap-2 font-unb text-sm">
            {
                menuItems.map(item => (
                    <a href={item.path} class="group flex flex-col gap-1 hover:text-primary relative py-2 text-4xl font-semibold text-left">
                        {item?.label}
                    </a>
                ))
            }
        </nav>
        <Button label="Agendar Diagnóstico Gratuito" href="https://cal.com/devworksstudio/consultoria-gratuita">
            <ArrowUpRight slot="right-icon"/>
        </Button>
    </div>
</header>

<script>
    const burger = document.querySelector('#burger') as HTMLButtonElement
    const mobileMenu = document.querySelector('#mobile-menu')

    burger.addEventListener('click', e => {
        const state = burger.dataset.open === 'open'
        if(state) {
            burger.dataset.open = 'closed'
            burger.classList.toggle('isOpen')
            mobileMenu?.classList.toggle('translate-x-full')
        } else {
            burger.dataset.open = 'open'
            burger.classList.toggle('isOpen')
            mobileMenu?.classList.toggle('translate-x-full')
        }
    })
</script>
