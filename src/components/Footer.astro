---
import { CalendarCheck } from "@lucide/astro";
import Button from "./ui/Button.astro";
import logo from '../assets/images/ds-white-logo.svg'
import facebook from '../assets/social/facebook.svg'
import instagram from '../assets/social/instagram.svg'
import { Image } from "astro:assets";

---
<footer class="bg-font text-font-light">
    <div class="md:px-11 lg:px-20 py-28 max-w-7xl mx-auto">
        <div class="flex flex-col gap-18">
            <div class="max-w-3xl">
                <h2 class="font-unb text-5xl font-semibold">
                    Deja de <span class="text-primary-light">regalarle</span> a tu competencia <span class="text-primary-light">campo en el mercado</span>.
                </h2>
                <p class="mt-8">Agenda una sesión de diagnóstico estratégico sin costo. Analizaremos tu posicionamiento actual, tu visibilidad en Google y definiremos el plan exacto para atraer clientes calificados.</p>
            </div>
            <div class="flex-1 flex flex-col items-end">
                <Button label="Agendar Diagnóstico Estratégico Gratuito" href="https://cal.com/devworksstudio/consultoria-gratuita">
                    <CalendarCheck size={'1.2rem'} slot={'icon'}/>
                </Button>
                <p class="text-gray-400 italic text-sm mr-2 mt-4">
                    Sesión de 20 minutos por videollamada. Cero presión de venta.
                </p>
            </div>
        </div>
        <span class="w-full h-px bg-primary-light/30 block my-28"></span>
        <div class="flex items-center justify-between">
            <Image src={logo} alt="DevWork Studio | Agencia web en Coahuila" height={30} />
            <div class="flex items-center gap-3">
                <a href="/" class="hover:scale-115 transition-transform ease-linear duration-150">
                    <Image src={instagram} alt="Instagram de DevWorks Studio | Agencia web en Coahuila" height={30} />
                </a>
                <a href="/" class="hover:scale-115 transition-transform ease-linear duration-150">
                    <Image src={facebook} alt="Facebook de DevWork Studio | Agencia web en Coahuila" height={30} />
                </a>
            </div>
        </div>
        <p class="text-center mt-8 text-xs text-gray-400">
            © 2026. Todos los derechos reservados. DevWorks Studio.
        </p>
    </div>
</footer>
